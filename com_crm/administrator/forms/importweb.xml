<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="details">
        <field name="id" type="hidden" />
        <field name="state" type="list" label="JSTATUS" default="1" class="chzn-color-state">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
            <option value="2">JARCHIVED</option>
            <option value="-2">JTRASHED</option>
        </field>
        <field name="nome" type="text" label="COM_CRM_NAME" description="" size="40" maxlength="150" filter="string" />
        <field name="origem" type="list" label="COM_CRM_SOURCE" description="" size="40">
            <option value="Google">Google</option>
            <option value="LinkedIn">LinkedIn</option>
            <option value="Facebook">Facebook</option>
            <option value="Instagram">Instagram</option>
        </field>
        <field name="palavras_chave" type="text" label="COM_CRM_KEYWORDS" description="" size="40" maxlength="500" filter="string" />
    </fieldset>
</form>
